<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ABChapterize</RootNamespace>
    <AssemblyName>abchapterize</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Keep the informational version (shown by the version option and in the usage
         note) a plain version number instead of appending "+<git commit hash>". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Generate (but do not ship) the XML documentation file: the point is not the file,
         it is that the compiler then validates every <see cref="..."/> in the doc comments
         and warns about <param> tags that no longer match a signature. Doc comments are the
         primary developer-facing documentation of this codebase, so letting them rot
         silently is not an option; PublishDocumentationFile keeps the .xml out of the
         release folders, where nothing would read it. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <!-- The doc-comment warnings are errors, not warnings, because a warning is only as good
         as the attention paid to it: four malformed comments once rode along in a build whose
         tail said "0 Fehler" and whose warning count nobody read. These are the ones that mean
         a comment has stopped matching the code - malformed XML, a <param> that names nothing,
         a parameter with no <param>, an unresolved cref, a broken <include> - i.e. exactly the
         rot GenerateDocumentationFile is switched on to catch. CS1591 ("missing XML comment")
         is deliberately not among them: it is a coverage rule, not a correctness one. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1592;CS1710;CS1711;CS1712;CS1723</WarningsAsErrors>
    <!-- win-x64 by default; publish for Linux with: dotnet publish -c Release -r linux-x64 -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Single-file publish for the managed code. The native Whisper libraries must stay
         in the "runtimes" folder next to the exe: Whisper.net probes that folder structure
         at run time to pick the best backend (CUDA/Vulkan/CPU variants even share file
         names, so they cannot be embedded into the bundle). -->
    <!-- Publish per platform into the deployed locations; the win-x64 one also holds the
         "models" folder. -->
    <PublishDir>bin\publish\$(RuntimeIdentifier)\</PublishDir>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- The unit test project under tests\ and the throwaway vadprobe diagnostic tool under
       tools\ each have their own csproj; keep their sources out of the default compile globs
       of this project. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="tools/**" />
  </ItemGroup>

  <!-- Auto-incrementing build number, baked in as assembly metadata read by CliOptions and
       surfaced only by the version-info command line option (never in the plain
       Version-based banner/usage text). The counter lives in BuildNumber.txt, tracked in git
       so it keeps counting up across clones instead of resetting. Only an actual publish of
       win-x64 (the default RuntimeIdentifier, see above) bumps it - _IsPublishing is set by
       "dotnet publish" and nothing else, which keeps IDE design-time/background builds (which
       also evaluate with the default RID) from silently racing the counter upward, an effect
       actually observed with VS Code's C# extension. Plain builds and linux-x64 publishes
       just read the current value without writing it back, so publishing both platforms for
       the same release embeds the same build number in each: publish win-x64 first, then
       linux-x64 picks up the same, freshly bumped number. -->
  <PropertyGroup>
    <BuildNumberFile>$(MSBuildProjectDirectory)\BuildNumber.txt</BuildNumberFile>
  </PropertyGroup>

  <!-- Hooked onto GetAssemblyAttributes specifically, not the outer GenerateAssemblyInfo: the
       SDK resolves GenerateAssemblyInfo's own DependsOnTargets chain - which is what actually
       populates and hashes @(AssemblyAttribute) and writes the generated file - before a
       BeforeTargets="GenerateAssemblyInfo" hook gets to run, so items added there arrive too
       late to be picked up. GetAssemblyAttributes is the actual target that builds up
       @(AssemblyAttribute) (by appending to it, so our items added here survive), and running
       before it lands our items in time for the hash/file-write that follows.
       Guarded on TargetFramework being set so this only fires for an actual compile, not the
       outer dispatch pass; the increment itself is further guarded on _IsPublishing (see the
       comment above). -->
  <Target Name="IncrementBuildNumber" BeforeTargets="GetAssemblyAttributes" Condition="'$(TargetFramework)' != ''">
    <ReadLinesFromFile File="$(BuildNumberFile)" Condition="Exists('$(BuildNumberFile)')">
      <Output TaskParameter="Lines" ItemName="_PreviousBuildNumberLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_PreviousBuildNumber Condition="'@(_PreviousBuildNumberLine)' != ''">@(_PreviousBuildNumberLine)</_PreviousBuildNumber>
      <_PreviousBuildNumber Condition="'$(_PreviousBuildNumber)' == ''">0</_PreviousBuildNumber>
      <_BumpBuildNumber>false</_BumpBuildNumber>
      <_BumpBuildNumber Condition="'$(_IsPublishing)' == 'true' and '$(RuntimeIdentifier)' == 'win-x64'">true</_BumpBuildNumber>
      <BuildNumber Condition="'$(_BumpBuildNumber)' == 'true'">$([MSBuild]::Add($(_PreviousBuildNumber), 1))</BuildNumber>
      <BuildNumber Condition="'$(_BumpBuildNumber)' != 'true'">$(_PreviousBuildNumber)</BuildNumber>
      <BuildTimestamp>$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm:ss')) UTC</BuildTimestamp>
    </PropertyGroup>
    <WriteLinesToFile File="$(BuildNumberFile)" Lines="$(BuildNumber)" Overwrite="true"
                       Condition="'$(_BumpBuildNumber)' == 'true'" />
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildNumber</_Parameter1>
        <_Parameter2>$(BuildNumber)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildTimestamp</_Parameter1>
        <_Parameter2>$(BuildTimestamp)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- The externalized doc-comment notes under notes\ are wired into the source with <include>
       directives (see notes\README.md). Roslyn warns when the notes *file* is missing (CS1589),
       but a directive whose XPath matches nothing fails silently: the compiler leaves the literal
       <include> element standing in the generated documentation and carries on. That is the rot
       actually worth guarding against - an anchor renamed on one side only - so it is checked here
       rather than trusted. A directive that did resolve is always replaced by the fragment it
       pulled in, so any surviving <include> element means a dead link. -->
  <Target Name="VerifyDocNoteIncludes" AfterTargets="Build"
          Condition="'$(TargetFramework)' != '' and '$(DocumentationFile)' != '' and Exists('$(DocumentationFile)')">
    <XmlPeek XmlInputPath="$(DocumentationFile)" Query="//include">
      <Output TaskParameter="Result" ItemName="_UnresolvedDocNoteInclude" />
    </XmlPeek>
    <Error Condition="'@(_UnresolvedDocNoteInclude)' != ''"
           Text="Unresolved doc-note include(s) in $(DocumentationFile) - a notes%5C anchor does not match its XPath: @(_UnresolvedDocNoteInclude, '%3B ')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Cuda" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.1" />
  </ItemGroup>

  <!-- Silero VAD model, bundled (MIT-licensed, see THIRD-PARTY-NOTICES.md) rather than
       downloaded: small enough (~2.2 MB) to embed directly into the assembly, avoiding a
       first-run download step entirely. Loaded from assembly resources by SileroWorker. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\silero_vad.onnx" LogicalName="ABChapterize.silero_vad.onnx" />
  </ItemGroup>

  <!-- LavaSR's speech denoiser, converted to ONNX by github.com/Topping1/LavaSR-ONNX
       (denoiser_core_legacy_fixed63.onnx, release Alpha-v0.1) and bundled for the same reason as
       the VAD above: 1.8 MB embeds without a download step. Apache-2.0, like LavaSR itself - see
       THIRD-PARTY-NOTICES.md, which also carries the upstream SHA-256 and the note to re-check
       that release monthly, the conversion being an alpha. Loaded by SpeechDenoiser. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\lavasr_denoiser.onnx" LogicalName="ABChapterize.lavasr_denoiser.onnx" />
  </ItemGroup>

  <!-- Ship the docs, third-party notices/license texts, and readme alongside the executable:
       LICENSE plus the licenses/ glob satisfy the "include the copyright notice" redistribution
       condition of ABChapterize's own MIT license and of every bundled MIT component, and
       doc/+README.md+CHANGELOG.md keep the manual and the release history available in every
       release.
       Globs so new files dropped into these folders are picked up automatically. -->
  <ItemGroup>
    <None Include="LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="CHANGELOG.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="doc\**\*" CopyToPublishDirectory="PreserveNewest" Link="doc\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="licenses\**\*" CopyToPublishDirectory="PreserveNewest" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Whisper.net.Runtime and Microsoft.ML.OnnxRuntime both copy natives for platforms this
       publish will never run on, in two different layouts, and both need cleaning up afterwards.
       Nothing below is keyed on a hardcoded list of *supported* targets: the target RID names what
       to keep and everything else is foreign, so adding a platform needs no new branch here. That
       matters more than it looks - this is the one macOS/ARM change that cannot degrade gracefully.
       Get it wrong and it deletes the natives the build needs, which is why the layout was
       verified by cross-publishing every RID from Windows and listing the folder (2026-08-22,
       Whisper.net 1.9.1 / Microsoft.ML.OnnxRuntime 1.27.1). -->
  <Target Name="PruneForeignRuntimes" AfterTargets="Publish">

    <!-- Mind the naming trap: Whisper.net calls the Apple Silicon folder macos-arm64 while the
         .NET RID is osx-arm64, so both spellings coexist in one publish and only one of them is
         foreign. Every other platform's folder happens to be spelled like its RID. -->
    <PropertyGroup>
      <_WhisperNativeDir Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">macos-arm64</_WhisperNativeDir>
      <_WhisperNativeDir Condition="'$(_WhisperNativeDir)' == ''">$(RuntimeIdentifier)</_WhisperNativeDir>
    </PropertyGroup>

    <ItemGroup>
      <!-- Whisper.net.Runtime's runtimes\&lt;platform&gt;\ layout: its .targets copies all eight of
           these for any plain (non-OS-specific) target framework, regardless of RuntimeIdentifier. -->
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\linux-arm;$(PublishDir)runtimes\linux-arm64;$(PublishDir)runtimes\linux-x64;$(PublishDir)runtimes\macos-arm64;$(PublishDir)runtimes\macos-x64;$(PublishDir)runtimes\win-arm64;$(PublishDir)runtimes\win-x64;$(PublishDir)runtimes\win-x86"
                          Exclude="$(PublishDir)runtimes\$(_WhisperNativeDir)" />
      <!-- The GPU-backend packages exist for two platforms only, so every other target keeps
           neither tree. That is not a gap to fill later: the Cuda-&gt;Vulkan-&gt;Cpu fallback in
           WhisperTranscriber already handles their absence, which is what makes a CPU-only
           platform a supported outcome rather than a broken one. -->
      <_ForeignRuntimeDir Include="$(PublishDir)runtimes\cuda\win-x64;$(PublishDir)runtimes\cuda\linux-x64;$(PublishDir)runtimes\vulkan\win-x64;$(PublishDir)runtimes\vulkan\linux-x64"
                          Exclude="$(PublishDir)runtimes\cuda\$(RuntimeIdentifier);$(PublishDir)runtimes\vulkan\$(RuntimeIdentifier)" />
    </ItemGroup>
    <RemoveDir Directories="@(_ForeignRuntimeDir)" />

    <!-- Unlike Whisper.net's runtimes\&lt;platform&gt;\ layout above, Microsoft.ML.OnnxRuntime drops
         natives loose in the publish root, from two independent mechanisms:
         * the RID-specific runtime asset, which is always the right one for this publish
           (verified by hash: a linux-arm64 publish gets the linux-arm64 libonnxruntime.so, not
           the linux-x64 one);
         * its own .props, which copies the *Windows* DLLs keyed on $(PlatformTarget) - the
           architecture, not the operating system. That is why a linux-arm64 publish carries a
           win-arm64 onnxruntime.dll and an osx-arm64 publish carries one too.
         The *.lib import libraries are Windows build-time-only artifacts, never needed at run
         time, so they go regardless of target. -->
    <ItemGroup>
      <!-- What this target keeps, moved into runtimes\&lt;rid&gt;\ below. macOS is the odd one out:
           the 1.27.1 package ships osx-arm64/native/libonnxruntime.dylib and nothing else, with no
           providers_shared counterpart, so naming one here would fail the Move task. -->
      <_OnnxRuntimeNativeFile Condition="$(RuntimeIdentifier.StartsWith('win-'))"
                              Include="$(PublishDir)onnxruntime.dll;$(PublishDir)onnxruntime_providers_shared.dll" />
      <_OnnxRuntimeNativeFile Condition="$(RuntimeIdentifier.StartsWith('linux-'))"
                              Include="$(PublishDir)libonnxruntime.so;$(PublishDir)libonnxruntime_providers_shared.so" />
      <_OnnxRuntimeNativeFile Condition="$(RuntimeIdentifier.StartsWith('osx-'))"
                              Include="$(PublishDir)libonnxruntime.dylib" />

      <!-- Every loose ONNX native this target does not keep. Listing all three platforms' names
           and subtracting the keepers is deliberate: which of them actually turn up depends on the
           publishing architecture, and a name that never appears simply makes Delete a no-op. -->
      <_ForeignPublishFile Include="$(PublishDir)onnxruntime.dll;$(PublishDir)onnxruntime_providers_shared.dll;$(PublishDir)libonnxruntime.so;$(PublishDir)libonnxruntime_providers_shared.so;$(PublishDir)libonnxruntime.dylib;$(PublishDir)onnxruntime.lib;$(PublishDir)onnxruntime_providers_shared.lib"
                           Exclude="@(_OnnxRuntimeNativeFile)" />
      <_ForeignPublishFile Include="$(PublishDir)abchapterize.pdb" />

      <!-- Whisper.net.Runtime.Metal - a transitive dependency of Whisper.net.Runtime, not
           referenced here - copies ggml-metal.metal (450 KB) into the publish *root* for any plain
           target framework, so every target pays for it. It is the Metal compute-shader source
           libggml-metal-whisper.dylib may fall back to at run time when it cannot use a
           precompiled library, and ggml looks for it beside the executable rather than in
           runtimes\, which is why it stays in the root rather than moving next to the dylib.
           Unverifiable from here (see doc\building-on-macos.md), so it is kept on the one platform
           that could possibly want it and pruned on the two that provably cannot. -->
      <_ForeignPublishFile Condition="!$(RuntimeIdentifier.StartsWith('osx-'))"
                           Include="$(PublishDir)ggml-metal.metal" />
    </ItemGroup>
    <Delete Files="@(_ForeignPublishFile)" />

    <!-- Move the correct-platform OnnxRuntime natives out of the publish root and into
         runtimes\&lt;rid&gt;\ alongside the Whisper natives, instead of leaving them loose next to
         the exe. OnnxRuntimeNative registers a DllImportResolver that loads "onnxruntime" from
         this exact location, so the two must be kept in sync. -->
    <Move SourceFiles="@(_OnnxRuntimeNativeFile)" DestinationFolder="$(PublishDir)runtimes\$(RuntimeIdentifier)\" />
  </Target>

</Project>
